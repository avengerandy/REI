{
    "manifest_version": 3,
    "name": "REI",
    "version": "0.0.1",
    "description": "A lightweight, frontend only recommendation toolkit.",
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "https://www.books.com.tw/web/sys_tdrntb/books/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://www.books.com.tw/web/sys_tdrntb/books/*"
            ],
            "js": [
                "dist/content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "dist/books.js"
            ],
            "matches": [
                "https://www.books.com.tw/*"
            ]
        }
    ]
}
